{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "CJ2 selected fan-item display authority",
    "subtitle": "Broken today: the panel re-walks live state, and a picked item has no view of its own. Fixed: each response publishes one validated revision, and one exact execution answers its view.",
    "output": "bd-2026-11-13-cj2.html",
    "quality_profile": "showcase"
  },
  "lanes": [
    {
      "id": "old",
      "label": "OLD - one response re-walks live state while the runner keeps writing",
      "variant": "exception"
    },
    {
      "id": "spine",
      "label": "Shared causes - the runner writes whether or not any panel is open; a click only picks which record answers",
      "variant": "normal"
    },
    {
      "id": "new",
      "label": "NEW - one published revision, one exact record per view"
    }
  ],
  "mainPath": [
    "capture",
    "commit",
    "n_view",
    "n_bind",
    "n_panel",
    "n_item"
